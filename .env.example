# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase CLI - Session Pooler URLs (Optional, para aplicar migrations sin IPv6)
# Obtener en: Dashboard → Project Settings → Database → Connection string → Session pooler
# Requerido para que `npm run db:push-dev` funcione en redes sin IPv6 (Vercel, la mayoría de ISPs).
# NO commitear las URLs reales — ponerlas en .env.local (ya gitignored)
# SUPABASE_DB_URL_DEV=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Rate Limiting with Upstash Redis (Optional)
# If not configured, local cache will be used for development
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Rate Limiting Configuration (Optional - uses defaults if not set)
# RATE_LIMIT_LOGIN_REQUESTS=5
# RATE_LIMIT_LOGIN_WINDOW=60000
# RATE_LIMIT_SEARCH_REQUESTS=30
# RATE_LIMIT_SEARCH_WINDOW=60000
# RATE_LIMIT_CREATE_CUSTOMER_REQUESTS=10
# RATE_LIMIT_CREATE_CUSTOMER_WINDOW=3600000
# RATE_LIMIT_ASSISTANCE_REQUESTS=20
# RATE_LIMIT_ASSISTANCE_WINDOW=3600000